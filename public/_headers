# static.cloudflareinsights.com is Cloudflare Web Analytics: the Pages project injects the
# beacon into index.html at deploy time, so the CSP has to allow the script and the endpoint
# it reports to. Drop both allowances if Web Analytics is ever switched off.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com

# Shared checks carry the whole bill in the URL — names, amounts, who paid.
# They are nobody's search result, and the payload space is unbounded, so keep
# every /s path out of the index. Header rather than meta because the SPA never
# sets one, and rather than robots.txt because a blocked crawler never reads it.
/s
  X-Robots-Tag: noindex, nofollow

/s/*
  X-Robots-Tag: noindex, nofollow

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
